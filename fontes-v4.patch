@@ -0,0 +1,32 @@
+name: Sondar fontes vazias
+
+# Manual. Para cada fonte ativa que hoje não tem nenhum lote, abre a primeira página e diz por que está vazia
+# (sem IA, só HTTP). O resultado aparece no resumo do job e no arquivo sondagem.csv (aba "Artifacts").
+on:
+  workflow_dispatch: {}
+
+jobs:
+  sondar:
+    runs-on: ubuntu-latest
+    timeout-minutes: 60
+    defaults:
+      run:
+        working-directory: coletor
+    env:
+      DATABASE_URL: ${{ secrets.DATABASE_URL }}
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-python@v5
+        with:
+          python-version: "3.11"
+      - run: pip install -e .
+      - name: Sondar
+        run: |
+          python -m coletor sondar | tee sondagem.txt
+          { echo '### Fontes vazias: por quê'; echo '```'; cat sondagem.txt; echo '```'; } >> "$GITHUB_STEP_SUMMARY"
+      - uses: actions/upload-artifact@v4
+        with:
+          name: sondagem
+          path: |
+            coletor/dados/sondagem.csv
+            coletor/sondagem.txt
