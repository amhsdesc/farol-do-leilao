+
+test("validade menor (pré-cálculo) renova antes dos 30 dias", async () => {
+  const a = armazemMemoria();
+  const { estado, buscarMcp } = portal({ bairro: mcpOk(varios("Asa Norte", 12), "bairro") });
+  await estimarMercado(asaNorte, dep(a, { buscarMcp }));
