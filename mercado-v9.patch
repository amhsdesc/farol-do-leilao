+
+test("registro vencido (mais de 30 dias) é refeito; dentro do prazo, não", async () => {
+  const a = armazemMemoria();
+  const { estado, buscarMcp } = portal({ bairro: mcpOk(varios("Asa Norte", 12), "bairro") });
