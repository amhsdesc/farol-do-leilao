+
+test("falha de rede da IA não é guardada: a próxima tentativa pode repetir", async () => {
+  const a = armazemMemoria();
+  const { buscarMcp } = portal({});
+  const ia = iaFalsa({ ok: false, vazio: false, erro: "Não consegui pesquisar agora." });
