+const CHAVE_ORIGINAL = process.env.ANTHROPIC_API_KEY;
+beforeEach(() => {
+  process.env.ANTHROPIC_API_KEY = "chave-de-teste";
+  delete process.env.ANTHROPIC_API_KEY_SITE;
+  delete process.env.MERCADO_SEM_MCP;
