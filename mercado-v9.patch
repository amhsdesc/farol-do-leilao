+
+test("reaproveitamento: bairro que veio de carona na busca da cidade é respondido do banco, sem rede", async () => {
+  const a = armazemMemoria();
+  const naCidade = [...varios("Lago Sul", 10, 14000), ...varios("Asa Sul", 12, 11000)];
