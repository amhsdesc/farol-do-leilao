+// Rodar: node --experimental-strip-types --test lib/calculadora/mercadoCore.test.ts
+import assert from "node:assert/strict";
+import { afterEach, beforeEach, test } from "node:test";
+import {
+  chaveDe,
+  classificarConfianca,
+  estimarMercado,
+  estimativaGuardada,
