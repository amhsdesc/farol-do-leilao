+  assert.equal(r.ok, false);
+});
+
+// ───────────── IA: último recurso ─────────────
+const anunciosIA = [an("", 9000), an("", 9500), an("", 10000), an("", 10500)];
+
+test("sem permissão (pré-cálculo, visitante): a IA nunca é chamada", async () => {
