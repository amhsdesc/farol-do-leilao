# Copie para .env e ajuste.
DATABASE_URL=postgresql://farol:farol@localhost:5432/farol

# E-mail de contato que vai no user-agent do coletor (boa prática com os sites coletados)
CONTATO_EMAIL=seu-email@exemplo.com

# Só necessário para fontes do tipo "automatico" (extração por IA). Crie em console.anthropic.com
ANTHROPIC_API_KEY=
MODELO_LLM=claude-haiku-4-5-20251001
LLM_MAX_PAGINAS_POR_EXECUCAO=200

# Coleta educada
INTERVALO_MINIMO_SEGUNDOS=2
RESPEITAR_ROBOTS=1


# ---- Site (web/.env.local) ----
# Segredo das sessões de login. Gere com:  npx auth secret   (ou qualquer texto aleatório longo)
AUTH_SECRET=
# Login com Google (docs/configurar-contas.md, passo 1)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Código de validação pelo WhatsApp (passo 2)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_MODELO_CODIGO=codigo_verificacao
# Cobrança pelo Asaas (passo 3). Comece com sandbox; troque para producao quando for valer.
ASAAS_API_KEY=
ASAAS_AMBIENTE=sandbox
ASAAS_WEBHOOK_TOKEN=

# Valor de mercado (botão da calculadora, ficha do imóvel e pré-cálculo semanal).
# Ordem de custo: banco (grátis) → portal Chaves na Mão, sem IA (grátis) → IA com busca na web (centavos por pesquisa).
# A IA é a ÚLTIMA reserva: só roda a pedido de um assinante, com chave e dentro do teto diário abaixo.
# Sem a chave, a calculadora continua funcionando com banco + portal; só as regiões sem anúncios suficientes ficam sem estimativa.
ANTHROPIC_API_KEY=
# Opcional: modelo diferente do padrão só para essa busca (o padrão é o mesmo MODELO_LLM do coletor).
# ANTHROPIC_MODELO_MERCADO=claude-haiku-4-5-20251001
# Teto de chamadas de IA por dia nessa pesquisa (padrão 30; 0 desliga a IA e deixa só banco + portal).
# MERCADO_MAX_IA_DIA=30
# Pré-cálculo semanal (workflow "Valor de mercado"): máximo de regiões gravadas por rodada e minutos (padrão 120 e 40).
# MERCADO_PRECALC_MAX=120
# MERCADO_PRECALC_MINUTOS=40

# Alertas por e-mail e WhatsApp (passo 4). Sem essas chaves, o alerta é só criado no banco:
# rode "npm run notificacoes" para ver o que teria sido mandado, sem nada sair de verdade.
RESEND_API_KEY=
RESEND_REMETENTE="Farol do Leilão <avisos@faroldoleilao.com.br>"
# Modelo de "utilidade" aprovado na Meta para mandar avisos fora da janela de 24h (diferente do
# WHATSAPP_MODELO_CODIGO, que é só para o código de verificação).
WHATSAPP_MODELO_ALERTA=alerta_leilao
# Endereço público do site, usado para montar o link da ficha nos avisos.
SITE_URL=http://localhost:3000

# SÓ NO SEU COMPUTADOR: login sem Google, código do celular na tela e pagamento simulado.
# Nunca use no site publicado.
# FAROL_MODO_TESTE=permitir
