+
+const agora = new Date("2026-10-10T12:00:00Z");
+const lote = (o: Partial<LoteParaEnriquecer> = {}): LoteParaEnriquecer => ({
+  url: "https://venda-imoveis.caixa.gov.br/sistema/detalhe-imovel.asp?hdnimovel=1",
